# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# --- docker-compose database containers ---
POSTGRES_USER=royalty
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=royalty
MONGO_USER=root
MONGO_PASSWORD=change_me_mongo

# --- application (Next.js reads these; no credentials are hard-coded anywhere) ---
DATABASE_URL=postgresql://royalty:change_me_postgres@localhost:5432/royalty
MONGODB_URI=mongodb://root:change_me_mongo@localhost:27017/?authSource=admin
MONGODB_DB=royalty_events

# Secret used to sign login sessions. Generate with:  openssl rand -base64 32
AUTH_SECRET=replace_with_a_long_random_string
