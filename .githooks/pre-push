#!/bin/sh
# Refuses to push any commit whose author/committer is Claude/Anthropic or that
# carries an AI co-author / "Generated with" line. Bypassing this hook (--no-verify)
# is forbidden by CLAUDE.md.
zero=0000000000000000000000000000000000000000
bad=0
while read local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue                      # branch deletion
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"                       # new branch: only unpublished commits
    else
        range="$remote_sha..$local_sha"
    fi
    if git log --format='%an %ae %cn %ce' $range | grep -i -E 'claude|anthropic' >/dev/null; then
        echo "pre-push: a commit is authored/committed by Claude/Anthropic. Re-author it as yourself first." >&2
        bad=1
    fi
    if git log --format='%B' $range | grep -i -E '^co-authored-by:.*(claude|anthropic)|^claude-session:|generated with.*claude' >/dev/null; then
        echo "pre-push: a commit message contains an AI attribution line. Amend the message first." >&2
        bad=1
    fi
done
[ "$bad" -eq 0 ] || { echo "pre-push: push blocked." >&2; exit 1; }
exit 0
